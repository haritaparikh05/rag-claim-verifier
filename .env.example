# Running with "docker compose up"? Only GEMINI_API_KEY (below) is needed; the database settings are for running
# the Python scripts directly on your machine and are overridden inside the containers.

# Postgres (local Docker Compose)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=claimverifier
DB_USER=claimverifier
DB_PASSWORD=claimverifier

# Gemini API (verdict step) - get one free at https://aistudio.google.com
GEMINI_API_KEY=
